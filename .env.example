# Application
SIGIF_APP_NAME=sigif-go
SIGIF_APP_ENV=development
SIGIF_APP_PORT=8080
SIGIF_APP_HOST=0.0.0.0
SIGIF_APP_READ_TIMEOUT=10
SIGIF_APP_WRITE_TIMEOUT=10
SIGIF_APP_IDLE_TIMEOUT=120

# Database
SIGIF_DATABASE_HOST=localhost
SIGIF_DATABASE_PORT=5432
SIGIF_DATABASE_USER=sigif
SIGIF_DATABASE_PASSWORD=sigif
SIGIF_DATABASE_NAME=sigif
SIGIF_DATABASE_SSL_MODE=disable
SIGIF_DATABASE_MAX_OPEN_CONNS=25
SIGIF_DATABASE_MAX_IDLE_CONNS=10
SIGIF_DATABASE_CONN_MAX_LIFETIME=300
SIGIF_DATABASE_LOG_LEVEL=silent

# JWT
SIGIF_JWT_SECRET=your-super-secret-jwt-key-change-in-production
SIGIF_JWT_ACCESS_TOKEN_EXPIRY=15
SIGIF_JWT_ISSUER=sigif-go

# Seed (default superadmin created on first migration)
SIGIF_SEED_ADMIN_EMAIL=admin@sigif.com
SIGIF_SEED_ADMIN_PASSWORD=admin123
SIGIF_SEED_ADMIN_FIRST_NAME=Admin
SIGIF_SEED_ADMIN_LAST_NAME=SIGIF

# CORS
SIGIF_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
SIGIF_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
SIGIF_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID
SIGIF_CORS_ALLOW_CREDENTIALS=true
SIGIF_CORS_EXPOSE_HEADERS=X-Request-ID

# Rate Limiting
SIGIF_RATE_LIMIT_ENABLED=true
SIGIF_RATE_LIMIT_MAX_REQUESTS=100
SIGIF_RATE_LIMIT_WINDOW_SECONDS=60

# Pagination
SIGIF_PAGINATION_DEFAULT_LIMIT=20
SIGIF_PAGINATION_MAX_LIMIT=100

# Logging
SIGIF_LOGGING_LEVEL=debug
SIGIF_LOGGING_FORMAT=console
SIGIF_LOGGING_OUTPUT=stdout

meta {
  name: Create Category - Invalid (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "   "
  }
}

tests {
  test("rechaza el nombre vacío con 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('name');
  });
}

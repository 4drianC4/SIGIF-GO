meta {
  name: List Taxes
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/taxes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve los impuestos sembrados", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data[0].name).to.equal('IVA general 13%');
    expect(res.body.data[0].percentage).to.equal(13);
  });
}

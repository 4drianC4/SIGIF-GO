meta {
  name: Inventory - Product Stock By Branch
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/api/v1/inventory/stock?product_id={{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve el saldo por sucursal para el producto", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
    if (res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property('branch_id');
      expect(res.body.data[0]).to.have.property('location_id');
      expect(res.body.data[0]).to.have.property('quantity');
    }
  });
}

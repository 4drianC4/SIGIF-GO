meta {
  name: List Units of Measure
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/units-of-measure
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  bru.setVar('unitId', res.body && res.body.data && res.body.data[0] ? res.body.data[0].id : '');
}

tests {
  test("devuelve las unidades sembradas", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data[0].abbreviation).to.equal('UNIT');
  });
}

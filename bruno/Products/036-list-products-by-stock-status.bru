meta {
  name: List Products By Stock Status
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/api/v1/products?stock_status=low_stock&search={{lowStockSku}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve solo los productos bajo mínimo", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].sku).to.equal(String(bru.getVar('lowStockSku')).toUpperCase());
    expect(res.body.data[0].stock_status).to.equal('low_stock');
    expect(res.body.meta.total).to.equal(1);
  });
}

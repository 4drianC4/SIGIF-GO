meta {
  name: Price History
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/price-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("lista los cambios de precio, el más reciente primero", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.data.length).to.equal(2);
    expect(res.body.meta.total).to.equal(2);
  });

  test("el último cambio es el ajuste de precio aceptado", function() {
    const last = res.body.data[0];
    expect(last.previous_cost).to.equal('4.50');
    expect(last.new_cost).to.equal('4.00');
    expect(last.previous_price).to.equal('7.50');
    expect(last.new_price).to.equal('9.00');
    expect(last.margin_pct).to.equal('56%');
    expect(last.reason).to.equal('Ajuste por costo');
    expect(last.user_full_name).to.be.a('string');
    expect(last.user_role).to.be.a('string');
  });

  test("la edición completa (PUT) también quedó en el historial", function() {
    const first = res.body.data[1];
    expect(first.new_cost).to.equal('4.50');
    expect(first.new_price).to.equal('7.50');
  });
}

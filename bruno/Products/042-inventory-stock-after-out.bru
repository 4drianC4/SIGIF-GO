meta {
  name: Inventory - Stock After Out
  type: http
  seq: 42
}

get {
  url: {{baseUrl}}/api/v1/inventory/stock?product_id={{lowStockProductId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("el saldo refleja la salida", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].quantity).to.equal('7');
  });
}

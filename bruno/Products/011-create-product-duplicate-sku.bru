meta {
  name: Create Product - Duplicate SKU (409)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Otro {{productName}}",
    "sku": "{{productSku}}",
    "category_id": "{{categoryId}}",
    "unit_of_measure_id": "{{unitId}}",
    "cost": 1,
    "sale_price": 2
  }
}

tests {
  test("rechaza el SKU repetido", function() {
    expect(res.status).to.equal(409);
    expect(res.body.error.message).to.equal('SKU already exists');
  });
}

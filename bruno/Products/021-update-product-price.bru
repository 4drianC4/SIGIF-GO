meta {
  name: Update Product Price
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/products/{{productId}}/price
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "cost": 4.00,
    "sale_price": 9.00,
    "reason": "Ajuste por costo"
  }
}

tests {
  test("responde 200 con los precios nuevos", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar('productId'));
    expect(res.body.data.cost).to.equal('4.00');
    expect(res.body.data.price).to.equal('9.00');
    expect(res.body.data.margin).to.equal(56);
  });

  test("el resto del producto no cambia", function() {
    expect(res.body.data.name).to.equal(bru.getVar('productName') + ' editado');
    expect(res.body.data.min_stock).to.equal('5');
  });
}

meta {
  name: Update Product Price Invalid
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/api/v1/products/{{productId}}/price
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "sale_price": 1.00
  }
}

tests {
  test("rechaza un precio menor que el costo con 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details.sale_price).to.be.a('string');
  });
}

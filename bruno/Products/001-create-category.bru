meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "{{categoryName}}",
    "description": "Gaseosas, jugos y aguas"
  }
}

script:pre-request {
  // Nombre único en cada ejecución para poder repetir la colección.
  bru.setVar('categoryName', 'Bebidas ' + Date.now());
}

script:post-response {
  bru.setVar('categoryId', res.body && res.body.data ? res.body.data.id : '');
}

tests {
  test("responde 201 con la categoría activa", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.name).to.equal(bru.getVar('categoryName'));
    expect(res.body.data.status).to.equal('active');
  });
}

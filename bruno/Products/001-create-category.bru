meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{categoryName}}",
    "parent_id": null,
    "default_tax": "IVA general 13%",
    "target_margin": 25
  }
}

script:pre-request {
  bru.setVar('categoryName', 'Abarrotes ' + Date.now());
}

script:post-response {
  bru.setVar('categoryId', res.body && res.body.data ? res.body.data.id : '');
}

tests {
  test("responde 201 con la categoría activa", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.default_tax).to.equal('IVA general 13%');
    expect(res.body.data.target_margin).to.equal(25);
    expect(res.body.data.parent_id).to.equal(null);
  });
}

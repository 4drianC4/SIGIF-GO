meta {
  name: Create Product - Duplicate SKU (409)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "category_id": "{{categoryId}}",
    "sku": "{{productSku}}",
    "name": "Otro producto con el mismo SKU",
    "unit_of_measure": "unit",
    "sale_price": 1
  }
}

tests {
  test("rechaza el SKU repetido con 409 CONFLICT", function() {
    expect(res.status).to.equal(409);
    expect(res.body.error.code).to.equal('CONFLICT');
  });
}

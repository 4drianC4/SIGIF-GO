meta {
  name: Validate Duplicate Lists Conflicts
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/api/v1/products/validate-duplicate?sku={{holderSkuLower}}&barcode={{holderBarcode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve cada conflicto con el producto que lo ocupa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.exists).to.equal(true);
    expect(res.body.data.field).to.equal('sku');
    expect(res.body.data.conflicts).to.have.lengthOf(2);
    expect(res.body.data.conflicts[1].existing_product.id).to.equal(bru.getVar('holderId'));
  });
}

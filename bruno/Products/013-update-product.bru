meta {
  name: Update Product
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/v1/products/{{productId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "category_id": "{{categoryId}}",
    "sku": "{{productSku}}-edit",
    "barcode": "{{productBarcode}}",
    "name": "Coca Cola 600ml Editada",
    "description": "Botella PET 600ml actualizada",
    "unit_of_measure": "unit",
    "cost_price": 3.50,
    "sale_price": "6.00"
  }
}

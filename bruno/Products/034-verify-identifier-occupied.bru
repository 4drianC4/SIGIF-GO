meta {
  name: Verify Identifier Occupied
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/api/v1/products/verificar-identificador?sku={{holderSkuLower}}&codigo_barras={{holderBarcode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  bru.setVar('holderSkuLower', String(bru.getVar('holderSku')).toLowerCase());
}

tests {
  test("informa el producto que ocupa los identificadores", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.available).to.equal(false);
    expect(res.body.data.existing_product.id).to.equal(bru.getVar('holderId'));
    expect(res.body.data.conflicts).to.have.lengthOf(2);
  });
}

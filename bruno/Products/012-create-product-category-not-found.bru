meta {
  name: Create Product - Category Not Found (404)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Sin categoría {{productName}}",
    "category_id": "00000000-0000-4000-8000-000000000000",
    "unit_of_measure_id": "{{unitId}}",
    "cost": 1,
    "sale_price": 2
  }
}

tests {
  test("responde 404 NOT_FOUND", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NOT_FOUND');
  });
}

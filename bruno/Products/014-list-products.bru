meta {
  name: List Products
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/products?page=1&limit=10&search={{productSku}}&status=active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve el producto con meta de paginación", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].stock_status).to.equal('out_of_stock');
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.meta.page).to.equal(1);
  });
}

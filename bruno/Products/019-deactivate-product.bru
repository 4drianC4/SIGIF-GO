meta {
  name: Deactivate Product
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/v1/products/{{productId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("responde 200 con status inactive", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
  });
}

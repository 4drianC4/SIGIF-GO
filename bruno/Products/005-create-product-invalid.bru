meta {
  name: Create Product - Invalid (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "category_id": "no-es-un-uuid",
    "sku": "",
    "barcode": "77501ABC",
    "name": "",
    "unit_of_measure": "barril"
  }
}

tests {
  test("responde 400 VALIDATION_ERROR con el detalle de cada campo", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    const details = res.body.error.details;
    ['category_id', 'sku', 'barcode', 'name', 'unit_of_measure', 'sale_price'].forEach(function(field) {
      expect(details).to.have.property(field);
    });
  });
}

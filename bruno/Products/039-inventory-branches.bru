meta {
  name: Inventory - List Branches
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/api/v1/inventory/branches
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve las sucursales con sus ubicaciones", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
    if (res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property('name');
      expect(res.body.data[0].locations).to.be.an('array');
    }
  });
}

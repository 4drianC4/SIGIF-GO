meta {
  name: List Categories
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve la lista con products_count", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
    expect(res.body.data[0]).to.have.property('products_count');
  });
}

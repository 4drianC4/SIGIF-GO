meta {
  name: Deactivate Superadmin - Protected (409)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{superadminId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("rechaza con 409 desactivar un rol protegido", function() {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('CONFLICT');
    expect(res.body.error.details.system).to.be.a('string');
  });
}

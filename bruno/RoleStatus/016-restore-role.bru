meta {
  name: Restore Role
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{employeeId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("restaura el rol a active", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('active');
  });
}

meta {
  name: Deactivate Role - Temporary
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{employeeId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("deja el rol inactivo", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
  });
}

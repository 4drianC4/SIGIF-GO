meta {
  name: Invalid Status Value (400)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{employeeId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "blocked"
  }
}

tests {
  test("rechaza con 400 un estado no soportado", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.details.status).to.be.a('string');
  });
}

meta {
  name: Without Token (401)
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{employeeId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("rechaza con 401 la petición sin token", function() {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
  });
}

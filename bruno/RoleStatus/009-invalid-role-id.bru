meta {
  name: Invalid Role Id (400)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/roles/no-es-un-uuid/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("rechaza con 400 un id con formato inválido", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('BAD_REQUEST');
  });
}

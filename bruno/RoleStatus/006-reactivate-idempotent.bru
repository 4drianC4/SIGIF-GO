meta {
  name: Reactivate Role - Already Active (Idempotent)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{employeeId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("repetir el mismo estado responde 200 sin error", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal('active');
  });
}

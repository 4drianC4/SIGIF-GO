meta {
  name: List Roles - Limit Above Max (400)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/roles/?limit=500
  body: none
  auth: bearer
}

params:query {
  limit: 500
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("rechaza con 400 y details.limit", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('limit');
    expect(res.body.error.details.limit).to.contain('100');
  });
}

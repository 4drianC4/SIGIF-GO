meta {
  name: List Roles - Invalid Page (400)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/roles/?page=0
  body: none
  auth: bearer
}

params:query {
  page: 0
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("rechaza con 400 y details.page", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('page');
  });
}

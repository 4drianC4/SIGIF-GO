meta {
  name: List Roles - Search By Name
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/roles/?q=SUPER
  body: none
  auth: bearer
}

params:query {
  q: SUPER
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 con los roles que contienen la búsqueda", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.meta.total).to.be.at.least(1);
    const names = res.body.data.map(r => r.name);
    expect(names).to.include('superadmin');
  });
}

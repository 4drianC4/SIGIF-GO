meta {
  name: List Roles - Search By Name
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/roles/?q=SUPER
  body: none
  auth: bearer
}

params:query {
  q: SUPER
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 con los roles que contienen la búsqueda (sin distinguir mayúsculas)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.data).to.have.lengthOf(1);
    expect(res.body.data[0].name).to.equal('superadmin');
    expect(res.body.data[0].type).to.equal('system');
  });
}

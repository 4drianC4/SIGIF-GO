meta {
  name: Setup - Login User Without roles.list
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{restrictedEmail}}",
    "password": "{{restrictedPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('tokenWithoutRolesList', res.body.data.token.access_token);
  }
}

tests {
  test("responde 200 con token y rol soporte", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.token.access_token).to.be.a('string');
    expect(res.body.data.user.role).to.equal('soporte');
  });
}

meta {
  name: List Roles - Type Custom
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/roles/?type=custom
  body: none
  auth: bearer
}

params:query {
  type: custom
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 solo con roles propios de la empresa del token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    res.body.data.forEach(function(r) {
      expect(r.type).to.equal('custom');
      expect(r.company_id).to.equal(bru.getVar('companyId'));
    });
  });

  test("no mezcla con los roles del sistema", function() {
    const names = res.body.data.map(r => r.name);
    expect(names).to.not.include('superadmin');
    expect(names).to.not.include('business_admin');
    expect(names).to.not.include('employee');
  });
}

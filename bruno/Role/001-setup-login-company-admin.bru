meta {
  name: Setup - Login Company Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{companyAdminEmail}}",
    "password": "{{companyAdminPassword}}"
  }
}

script:post-response {
  // El access token ya no viaja en el JSON: se extrae de la cookie HttpOnly
  // para seguir usándolo como Authorization: Bearer en esta colección.
  const authCookie = [].concat(res.getHeader('set-cookie') || [])
    .map((c) => c.split(';')[0])
    .find((c) => c.startsWith('sigif_access_token='));
  const accessTokenFromCookie = authCookie ? authCookie.substring('sigif_access_token='.length) : null;
  if (res.body && res.body.data) {
    bru.setVar('accessToken', accessTokenFromCookie);
    bru.setVar('companyId', res.body.data.user.company_id);
  }
}

tests {
  test("responde 200 con token de un usuario con empresa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.token).to.equal(undefined);
    expect([].concat(res.getHeader('set-cookie') || []).some((c) => c.startsWith('sigif_access_token='))).to.equal(true);
    expect(res.body.data.user.company_id).to.be.a('string');
  });
}

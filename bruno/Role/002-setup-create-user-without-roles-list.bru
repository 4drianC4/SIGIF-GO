meta {
  name: Setup - Create User Without roles.list
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "first_name": "Empleado",
    "last_name": "Sin Roles",
    "email": "{{restrictedEmail}}",
    "role": "employee",
    "company_id": "{{companyId}}"
  }
}

script:pre-request {
  bru.setVar('restrictedEmail', 'hu08202.' + Date.now() + '@example.com');
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('restrictedPassword', res.body.data.generated_password);
  }
}

tests {
  test("responde 201 con el usuario creado y contraseña generada", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.be.a('string');
    expect(res.body.data.email).to.equal(bru.getVar('restrictedEmail'));
    expect(res.body.data.role).to.equal('employee');
    expect(res.body.data.status).to.equal('active');
    expect(res.body.data.generated_password).to.be.a('string').with.lengthOf(32);
  });
}

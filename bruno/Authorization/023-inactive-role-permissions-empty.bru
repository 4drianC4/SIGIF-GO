meta {
  name: Inactive Role Has No Permissions
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/auth/me/permissions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("the session is still valid but no permission is reported", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.permissions).to.be.an('array');
    expect(res.body.data.permissions.length).to.equal(0);
  });
}

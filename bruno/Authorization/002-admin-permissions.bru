meta {
  name: Admin Permissions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me/permissions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the permission codes of the current user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.role).to.equal('superadmin');
    expect(res.body.data.role_id).to.be.a('string');
    expect(res.body.data.permissions).to.be.an('array');
    expect(res.body.data.permissions.includes('users.create')).to.equal(true);
    expect(res.body.data.permissions.includes('users.list')).to.equal(true);
  });
}

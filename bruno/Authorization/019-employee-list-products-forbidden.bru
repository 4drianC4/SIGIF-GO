meta {
  name: Employee Lists Products (403)
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employeeToken}}
}

tests {
  test("returns 403 FORBIDDEN without products.read", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
    expect(res.body.error.message).to.be.a('string');
    expect(Object.keys(res.body).includes('data')).to.equal(false);
  });
}

meta {
  name: Permissions Without Token (401)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/auth/me/permissions
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHORIZED without a token", function() {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
    expect(res.body.error.message).to.be.a('string');
  });
}

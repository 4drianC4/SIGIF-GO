meta {
  name: Business Admin Permissions
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/auth/me/permissions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("returns only the codes granted to the role", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.role).to.equal('business_admin');
    expect(res.body.data.permissions.includes('users.list')).to.equal(true);
    expect(res.body.data.permissions.includes('users.read')).to.equal(true);
    expect(res.body.data.permissions.includes('users.create')).to.equal(false);
    expect(res.body.data.permissions.includes('users.delete')).to.equal(false);
  });
}

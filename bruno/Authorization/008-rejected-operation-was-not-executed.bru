meta {
  name: Rejected Operation Was Not Executed
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/users/by-email?email={{rejectedEmail}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("the user of the rejected request was never created", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.be.a('string');
  });
}

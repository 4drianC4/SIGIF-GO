meta {
  name: Rejected Category Was Not Created
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{rejectedCategory}}",
    "description": "Created by an authorized user"
  }
}

tests {
  test("an authorized user can create it, so the rejected request never ran (no 409 for a duplicate name)", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.name).to.equal(bru.getVar('rejectedCategory'));
  });
}

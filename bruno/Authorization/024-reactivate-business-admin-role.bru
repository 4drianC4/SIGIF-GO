meta {
  name: Reactivate Business Admin Role
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/v1/roles/{{businessAdminRoleId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("the role is active again", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('active');
  });
}

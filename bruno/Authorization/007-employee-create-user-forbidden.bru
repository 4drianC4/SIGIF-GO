meta {
  name: Employee Creates User (403)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{employeeToken}}
}

body:json {
  {
    "first_name": "Ana",
    "last_name": "Pérez",
    "email": "{{rejectedEmail}}",
    "company_id": "{{companyId}}",
    "role": "employee"
  }
}

script:pre-request {
  bru.setVar('rejectedEmail', 'hu08206.rejected.' + Date.now() + '@example.com');
}

tests {
  test("returns 403 FORBIDDEN without users.create", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
    expect(res.body.error.message).to.be.a('string');
  });
}

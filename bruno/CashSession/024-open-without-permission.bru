meta {
  name: Open Without Permission (403)
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/cash-sessions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{readerToken}}
}

body:json {
  {
    "opening_amount": 100
  }
}

tests {
  test("responde 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
    expect(res.body.error.message).to.be.a('string');
  });
}

meta {
  name: Open With Zero Amount
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/cash-sessions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessTokenB}}
}

body:json {
  {
    "opening_amount": 0
  }
}

tests {
  test("un monto inicial de 0 es válido", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.opening_amount).to.equal(0);
    expect(res.body.data.opening_notes).to.equal(null);
    expect(res.body.data.cash_register.code).to.equal('CAJA-02');
  });
}

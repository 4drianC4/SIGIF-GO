meta {
  name: Open Without Token (401)
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/cash-sessions/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "opening_amount": 100
  }
}

script:pre-request {
  // Bruno reenvía la cookie HttpOnly del último login; se borra para que
  // la petición viaje de verdad sin credenciales.
  await bru.cookies.delete('sigif_access_token');
}

tests {
  test("responde 401 UNAUTHORIZED", function() {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
    expect(res.body.error.message).to.be.a('string');
  });
}

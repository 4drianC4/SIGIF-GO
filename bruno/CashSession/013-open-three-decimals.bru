meta {
  name: Open With Three Decimals (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/cash-sessions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessTokenA}}
}

body:json {
  {
    "opening_amount": 10.005
  }
}

tests {
  test("responde 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.message).to.be.a('string');
    expect(res.body.error.details.opening_amount).to.be.a('string');
  });
}

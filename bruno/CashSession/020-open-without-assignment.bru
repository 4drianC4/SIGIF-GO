meta {
  name: Open Without Assigned Register (404)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/cash-sessions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessTokenB}}
}

body:json {
  {
    "opening_amount": 100
  }
}

tests {
  test("responde 404 NO_ACTIVE_ASSIGNMENT", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NO_ACTIVE_ASSIGNMENT');
    expect(res.body.error.message).to.be.a('string');
  });
}

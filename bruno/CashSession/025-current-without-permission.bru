meta {
  name: Current Without Permission (403)
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/cash-sessions/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("responde 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
    expect(res.body.error.message).to.be.a('string');
  });
}

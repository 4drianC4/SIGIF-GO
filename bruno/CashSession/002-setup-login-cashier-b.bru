meta {
  name: Setup - Login Cashier B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{cashierBEmail}}",
    "password": "{{cashierBPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('accessTokenB', res.body.data.token.access_token);
    bru.setVar('cashierBId', res.body.data.user.id);
  }
}

tests {
  test("responde 200 con token", function() {
    expect(res.status).to.equal(200);
  });
}

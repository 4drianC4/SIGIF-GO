meta {
  name: Setup - Login Cashier A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{cashierAEmail}}",
    "password": "{{cashierAPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('accessTokenA', res.body.data.token.access_token);
    bru.setVar('cashierAId', res.body.data.user.id);
  }
}

tests {
  test("responde 200 con token", function() {
    expect(res.status).to.equal(200);
  });
}

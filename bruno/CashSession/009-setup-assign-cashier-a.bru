meta {
  name: Setup - Assign CAJA-01 To Cashier A
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/cash-register-assignments/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessTokenA}}
}

body:json {
  {
    "cash_register_id": "{{register1Id}}"
  }
}

script:post-response {
  bru.setVar('assignmentAId', res.body && res.body.data ? res.body.data.id : '');
}

tests {
  test("responde 201 con CAJA-01 asignada", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.cash_register.code).to.equal('CAJA-01');
  });
}

meta {
  name: Current Session Without Session (404)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/cash-sessions/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessTokenA}}
}

tests {
  test("responde 404 NO_OPEN_CASH_SESSION", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NO_OPEN_CASH_SESSION');
    expect(res.body.error.message).to.be.a('string');
  });
}

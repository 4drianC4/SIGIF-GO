meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  "email": "admin@sigif.com",
  "password": "admin123"
}

script:post-response {
bru.setVar('accessToken', res.body && res.body.data && res.body.data.token ? res.body.data.token.access_token : '');
bru.setVar('userId', res.body && res.body.data && res.body.data.user ? res.body.data.user.id : '');
}

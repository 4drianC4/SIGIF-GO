meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenantId}}
}

body:json {
  "email": "admin@sigif.com",
  "password": "password123"
}

script:post-response {
bru.setVar('accessToken', res.body && res.body.data && res.body.data.tokenPair ? res.body.data.tokenPair.accessToken : '');
bru.setVar('refreshToken', res.body && res.body.data && res.body.data.tokenPair ? res.body.data.tokenPair.refreshToken : '');
bru.setVar('userId', res.body && res.body.data && res.body.data.user ? res.body.data.user.id : '');
bru.setVar('tenantId', res.body && res.body.data && res.body.data.user ? res.body.data.user.tenantId : '');
bru.setVar('companyId', res.body && res.body.data && res.body.data.user ? res.body.data.user.companyId || '' : '');
}

meta {
  name: Me (Bearer de respaldo)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authCookieToken}}
}

tests {
  test("Authorization: Bearer sigue funcionando para clientes no navegador", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.email).to.equal(bru.getEnvVar('companyAdminEmail'));
  });
}

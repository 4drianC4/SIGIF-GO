meta {
  name: Refresh Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-ID: {{tenantId}}
}

body:json {
  "refresh_token": "{{refreshToken}}"
}

script:post-response {
bru.setVar('accessToken', res.body && res.body.data ? res.body.data.accessToken : '');
bru.setVar('refreshToken', res.body && res.body.data ? res.body.data.refreshToken : '');
}

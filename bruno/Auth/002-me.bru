meta {
  name: Me (cookie)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Cookie: sigif_access_token={{authCookieToken}}
}

tests {
  test("autentica con la cookie, sin Authorization", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.email).to.equal(bru.getEnvVar('companyAdminEmail'));
  });
}

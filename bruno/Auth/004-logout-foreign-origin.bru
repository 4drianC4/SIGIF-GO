meta {
  name: Logout desde origen no permitido (CSRF)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  Origin: https://evil.example
  Cookie: sigif_access_token={{authCookieToken}}
}

tests {
  test("rechaza con 403 una petición que cambia estado desde otro origen", function() {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal('FORBIDDEN');
  });
}

{
  "name": "Pharmacy",
  "requests": [
    {
      "name": "Create Doctor",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/doctors",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"first_name\": \"Carlos\",\n  \"last_name\": \"Mendoza\",\n  \"license_number\": \"MED-12345\",\n  \"specialty\": \"Medicina General\",\n  \"email\": \"carlos.mendoza@clinic.com\",\n  \"phone\": \"+57 1 555 0123\",\n  \"clinic_name\": \"Clínica Central\",\n  \"clinic_address\": \"Av. Caracas # 50-25, Bogotá\"\n      }"
      }
    },
    {
      "name": "List Doctors",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/doctors?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Create Prescription",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/prescriptions",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"company_id\": \"{{companyId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"doctor_id\": \"\",\n  \"prescription_number\": \"RX-2024-001\",\n  \"prescription_date\": \"2024-01-15T10:00:00Z\",\n  \"type\": \"simple\",\n  \"expiry_date\": \"2024-02-14T10:00:00Z\",\n  \"doctor_name\": \"Dr. Carlos Mendoza\",\n  \"doctor_license\": \"MED-12345\",\n  \"doctor_specialty\": \"Medicina General\",\n  \"clinic_name\": \"Clínica Central\",\n  \"clinic_address\": \"Av. Caracas # 50-25, Bogotá\",\n  \"diagnosis\": \"Hipertensión arterial\",\n  \"notes\": \"Tomar en ayunas\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"product_name\": \"Losartan 50mg\",\n      \"dosage\": \"50mg\",\n      \"form\": \"tableta\",\n      \"route\": \"oral\",\n      \"frequency\": \"1 cada 24 horas\",\n      \"duration\": \"30 días\",\n      \"quantity\": 30,\n      \"instructions\": \"Tomar en ayunas con agua\",\n      \"substitution_allowed\": true\n    }\n  ]\n      }"
      },
      "scripts": {
        "post": "if (res.status === 201) {\n  bru.setVar('prescriptionId', res.body.data.id);\n}"
      }
    },
    {
      "name": "List Prescriptions",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/prescriptions?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get Prescription by ID",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Verify Prescription",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/verify",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Dispense Prescription",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/dispense",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"items\": [\n    {\n      \"item_id\": \"\",\n      \"dispensed_quantity\": 30,\n      \"batch_number\": \"BAT-2024001\",\n      \"expiry_date\": \"2025-01-15\"\n    }\n  ]\n      }"
      }
    },
    {
      "name": "Cancel Prescription",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/cancel",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"reason\": \"Paciente no retira medicamento\"\n      }"
      }
    },
    {
      "name": "Controlled Substance Log",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/controlled-substances/logs?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    }
  ]
}
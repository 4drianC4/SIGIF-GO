{
  "name": "Hardware",
  "requests": [
    {
      "name": "Create Serial Number",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/serial-numbers",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"product_id\": \"{{productId}}\",\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"serial_number\": \"SN-LAP-2024-001\",\n  \"manufacturer_sn\": \"MFR-LAP-789012\",\n  \"purchase_cost\": 2500000,\n  \"warranty_start\": \"2024-01-15\",\n  \"warranty_end\": \"2025-01-15\"\n      }"
      }
    },
    {
      "name": "Bulk Create Serial Numbers",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/serial-numbers/bulk",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"product_id\": \"{{productId}}\",\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"start_serial\": \"SN-LAP-2024-100\",\n  \"count\": 50,\n  \"purchase_cost\": 2500000,\n  \"warranty_months\": 12\n      }"
      }
    },
    {
      "name": "List Serial Numbers",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/serial-numbers?page=1&limit=20&status=available",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get Serial Number",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/serial-numbers/{{serialNumberId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Sell Serial Number",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/serial-numbers/{{serialNumberId}}/sell",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"sale_id\": \"{{saleId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"sale_price\": 3500000\n      }"
      }
    },
    {
      "name": "Return Serial Number",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/serial-numbers/{{serialNumberId}}/return",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Create Warranty Claim",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/warranty-claims",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"serial_number_id\": \"{{serialNumberId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"claim_number\": \"WC-2024-001\",\n  \"issue_type\": \"hardware_failure\",\n  \"description\": \"Laptop no enciende, posible falla de motherboard\"\n      }"
      }
    },
    {
      "name": "List Warranty Claims",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/warranty-claims?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Update Warranty Claim",
      "method": "PUT",
      "url": "{{baseUrl}}/api/v1/warranty-claims/{{claimId}}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"status\": \"approved\",\n  \"diagnosis\": \"Falla en motherboard, reemplazo necesario\",\n  \"resolution\": \"Reemplazo de motherboard bajo garantía\"\n      }"
      }
    },
    {
      "name": "Create Service Order",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/service-orders",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"serial_number_id\": \"{{serialNumberId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"order_number\": \"SO-2024-001\",\n  \"service_type\": \"repair\",\n  \"description\": \"Laptop no enciende, revisar motherboard\",\n  \"received_date\": \"2024-01-15T10:00:00Z\",\n  \"estimated_cost\": 150000\n      }"
      }
    },
    {
      "name": "List Service Orders",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/service-orders?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Update Service Order",
      "method": "PUT",
      "url": "{{baseUrl}}/api/v1/service-orders/{{serviceOrderId}}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"status\": \"completed\",\n  \"diagnosis\": \"Motherboard dañada por sobretensión\",\n  \"resolution\": \"Reemplazo de motherboard, prueba de estrés exitosa\",\n  \"parts_cost\": 120000,\n  \"labor_cost\": 80000\n      }"
      }
    }
  ]
}
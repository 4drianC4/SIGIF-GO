meta {
  name: Edit User
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "first_name": "Juan Carlos",
    "last_name": "Pérez Gómez",
    "email": "business_admin@sigif.com",
    "role": "business_admin",
    "password": "nuevaPassword123",
    "company_id": "{{companyId}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('userPassword', 'nuevaPassword123');
  }
}

tests {
  test("edita empresa y rol sin exponer contraseña", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.company_id).to.equal(bru.getVar('companyId'));
    expect(res.body.data.role).to.equal('business_admin');
    expect(res.body.data).not.to.have.property('generated_password');
    expect(res.body.data).not.to.have.property('password_hash');
  });
}

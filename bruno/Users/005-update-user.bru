meta {
  name: Update User
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  "first_name": "Juan Carlos",

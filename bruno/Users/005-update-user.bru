meta {
  name: Update User
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "first_name": "Juan Carlos",
    "last_name": "Pérez Gómez",
    "phone": "+57 300 123 4567",
    "area": "Soporte técnico"
  }
}

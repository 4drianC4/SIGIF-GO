meta {
  name: History After Deactivate
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("history is preserved after deactivating the user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(4);
    expect(res.body.data[0].action).to.equal('deactivated');
    expect(res.body.data[0].performed_by.id).to.equal(bru.getVar('adminId'));
    expect(res.body.data[3].action).to.equal('created');
  });
}

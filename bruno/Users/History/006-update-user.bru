meta {
  name: Update User
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "first_name": "Juan Carlos",
    "email": "{{historyUserNewEmail}}"
  }
}

script:pre-request {
  bru.setVar('historyUserNewEmail', 'hu0203.edited.' + Date.now() + '@example.com');
}

tests {
  test("returns 200 with the updated user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.first_name).to.equal('Juan Carlos');
  });
}

meta {
  name: History After Create
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the created event with its actor", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.data.length).to.equal(1);
    const event = res.body.data[0];
    expect(event.id).to.be.a('string');
    expect(event.user_id).to.equal(bru.getVar('historyUserId'));
    expect(event.action).to.equal('created');
    expect(event.description).to.equal('User created');
    expect(event.created_at).to.be.a('string');
    expect(event.performed_by.id).to.equal(bru.getVar('adminId'));
    expect(event.performed_by.email).to.equal(bru.getVar('adminEmail'));
    expect(event.performed_by.full_name).to.be.a('string');
  });

  test("returns pagination meta", function() {
    expect(res.body.meta.page).to.equal(1);
    expect(res.body.meta.limit).to.equal(20);
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.meta.total_pages).to.equal(1);
  });
}

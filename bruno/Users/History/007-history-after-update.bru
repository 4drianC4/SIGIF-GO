meta {
  name: History After Update
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("keeps the created event and adds the update on top", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(2);
    expect(res.body.data[0].action).to.equal('updated');
    expect(res.body.data[1].action).to.equal('created');
  });

  test("returns the changed fields with from and to", function() {
    const changes = res.body.data[0].changes;
    expect(changes.first_name.from).to.equal('Juan');
    expect(changes.first_name.to).to.equal('Juan Carlos');
    expect(changes.email.from).to.equal(bru.getVar('historyUserEmail'));
    expect(changes.email.to).to.equal(bru.getVar('historyUserNewEmail'));
    expect(Object.keys(changes).length).to.equal(2);
  });
}

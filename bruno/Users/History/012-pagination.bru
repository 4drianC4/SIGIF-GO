meta {
  name: Pagination
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history?page=2&limit=3
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the requested page", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.page).to.equal(2);
    expect(res.body.meta.limit).to.equal(3);
    expect(res.body.meta.total).to.equal(4);
    expect(res.body.meta.total_pages).to.equal(2);
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].action).to.equal('created');
  });
}

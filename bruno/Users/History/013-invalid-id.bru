meta {
  name: Invalid ID (400)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/users/not-a-uuid/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 400 BAD_REQUEST for a malformed id", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('BAD_REQUEST');
  });
}

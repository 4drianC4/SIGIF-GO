meta {
  name: Without Permission (403)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenWithoutPermission}}
}

tests {
  test("returns 403 FORBIDDEN without users.read", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
  });
}

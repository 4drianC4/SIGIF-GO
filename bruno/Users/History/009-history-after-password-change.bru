meta {
  name: History After Password Change
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/users/{{historyUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("records password_changed without any password value", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(3);
    expect(res.body.data[0].action).to.equal('password_changed');
    expect(Object.keys(res.body.data[0].changes).length).to.equal(0);
    expect(JSON.stringify(res.body).includes('NewPassword123')).to.equal(false);
    expect(JSON.stringify(res.body).includes(bru.getVar('historyUserPassword'))).to.equal(false);
  });
}

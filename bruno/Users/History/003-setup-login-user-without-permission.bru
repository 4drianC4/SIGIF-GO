meta {
  name: Setup - Login User Without Permission
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{historyUserEmail}}",
    "password": "{{historyUserPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('tokenWithoutPermission', res.body.data.token.access_token);
  }
}

tests {
  test("returns 200 with an access token", function() {
    expect(res.status).to.equal(200);
  });
}

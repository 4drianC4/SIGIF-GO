{
  "name": "Users",
  "requests": [
    {
      "name": "Create User",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"email\": \"cajero@sigif.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Pérez\",\n  \"phone\": \"+57 300 123 4567\",\n  \"roles\": [\"cashier\"],\n  \"company_id\": \"{{companyId}}\"\n}"
      },
      "scripts": {
        "post": "if (res.status === 201) {\n  bru.setVar('userId', res.body.data.id);\n}"
      }
    },
    {
      "name": "List Users",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/users?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get User by ID",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get User by Email",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/users/by-email?email=cajero@sigif.com",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Update User",
      "method": "PUT",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"first_name\": \"Juan Carlos\",\n  \"last_name\": \"Pérez Gómez\",\n  \"phone\": \"+57 300 123 4567\",\n  \"roles\": [\"cashier\", \"inventory\"],\n  \"settings\": {\n    \"language\": \"es\",\n    \"timezone\": \"America/Bogota\",\n    \"theme\": \"dark\",\n    \"notifications\": true\n  }\n}"
      }
    },
    {
      "name": "Change Password",
      "method": "PUT",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}/password",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword456\"\n}"
      }
    },
    {
      "name": "Activate User",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}/activate",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Deactivate User",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}/deactivate",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Suspend User",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}/suspend",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Delete User",
      "method": "DELETE",
      "url": "{{baseUrl}}/api/v1/users/{{userId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    }
  ]
}
meta {
  name: Change Password
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "current_password": "password123",
    "new_password": "newpassword456"
  }
}

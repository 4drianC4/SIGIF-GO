meta {
  name: Login Deactivated User (401)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{deactivationUserEmail}}",
    "password": "{{deactivationUserPassword}}"
  }
}

tests {
  test("a deactivated user cannot log in", function() {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
  });
}

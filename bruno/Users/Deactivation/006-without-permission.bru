meta {
  name: Without Permission (403)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/users/{{deactivationUserId}}/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenWithoutPermission}}
}

tests {
  test("returns 403 FORBIDDEN without users.deactivate", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
  });
}

meta {
  name: History After Deactivation
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/users/{{deactivationUserId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("history is preserved and records the deactivation", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(2);
    expect(res.body.data[0].action).to.equal('deactivated');
    expect(res.body.data[0].performed_by.id).to.equal(bru.getVar('adminId'));
    expect(res.body.data[1].action).to.equal('created');
  });
}

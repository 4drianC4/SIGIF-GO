meta {
  name: User Not Found (404)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/users/00000000-0000-4000-8000-000000000000/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 404 NOT_FOUND for an unknown user", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NOT_FOUND');
  });
}

meta {
  name: Setup - Login User Before Deactivation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{deactivationUserEmail}}",
    "password": "{{deactivationUserPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('tokenWithoutPermission', res.body.data.token.access_token);
  }
}

tests {
  test("an active user can log in", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.token.access_token).to.be.a('string');
  });
}

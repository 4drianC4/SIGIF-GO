meta {
  name: Setup - Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "first_name": "Juan",
    "last_name": "Pérez",
    "email": "{{deactivationUserEmail}}",
    "company_id": "{{companyId}}",
    "role": "employee"
  }
}

script:pre-request {
  bru.setVar('deactivationUserEmail', 'hu0204.' + Date.now() + '@example.com');
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('deactivationUserId', res.body.data.id);
    bru.setVar('deactivationUserPassword', res.body.data.generated_password);
  }
}

tests {
  test("returns 201 with an active user", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal('active');
  });
}

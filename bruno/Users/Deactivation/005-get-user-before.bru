meta {
  name: Get User Before Deactivation
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/users/{{deactivationUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the active user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar('deactivationUserId'));
    expect(res.body.data.status).to.equal('active');
  });
}

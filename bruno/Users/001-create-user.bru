meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "first_name": "Juan",
    "last_name": "Pérez",
    "email": "soporte@sigif.com",
    "password": "password123",
    "role": "soporte",
    "area": "Soporte técnico"
  }
}

script:post-response {
  bru.setVar('userId', res.body && res.body.data ? res.body.data.id : '');
}

meta {
  name: Create Permission - Unknown Module (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/permissions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "module": "invoices",
    "operation": "create"
  }
}

tests {
  test("rechaza con 400 un módulo fuera del catálogo", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details.module).to.equal('not a supported module');
  });
}
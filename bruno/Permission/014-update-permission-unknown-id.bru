meta {
  name: Update Permission - Unknown Id (404)
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/permissions/00000000-0000-0000-0000-000000000000
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "description": "No existe"
  }
}

tests {
  test("rechaza con 404 un permiso inexistente", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NOT_FOUND');
  });
}

meta {
  name: Create Permission - Invalid Operation (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/permissions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "module": "users",
    "operation": "destroy"
  }
}

tests {
  test("rechaza con 400 una operación fuera del catálogo", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details.operation).to.equal('not a supported operation');
  });
}
meta {
  name: List Permission Modules
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/permissions/modules
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 con el catálogo de módulos y sus operaciones", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    const modules = res.body.data.map(m => m.module);
    expect(modules).to.include('users');
    expect(modules).to.include('permissions');
    const users = res.body.data.find(m => m.module === 'users');
    expect(users.operations).to.include('read');
    expect(users.operations).to.include('export');
  });
}
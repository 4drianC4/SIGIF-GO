meta {
  name: List Permissions - Without Token (401)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/permissions/
  body: none
  auth: none
}

tests {
  test("rechaza con 401 la petición sin token", function() {
    expect(res.status).to.equal(401);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
  });
}
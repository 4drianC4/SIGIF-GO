meta {
  name: Export Permissions
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/permissions/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("exporta el catálogo como CSV", function() {
    expect(res.status).to.equal(200);
    expect(res.headers['content-type']).to.include('text/csv');
    expect(res.body).to.include('module,operation,code');
  });
}

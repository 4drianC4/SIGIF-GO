{
  "name": "Sales",
  "requests": [
    {
      "name": "Create Customer",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/customers",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"code\": \"CLI-001\",\n  \"first_name\": \"María\",\n  \"last_name\": \"González\",\n  \"email\": \"maria.gonzalez@email.com\",\n  \"phone\": \"+57 310 987 6543\",\n  \"document_type\": \"CC\",\n  \"document_number\": \"1234567890\",\n  \"address\": \"Carrera 7 # 45-67\",\n  \"city\": \"Bogotá\",\n  \"state\": \"Cundinamarca\",\n  \"country\": \"Colombia\",\n  \"postal_code\": \"110111\",\n  \"customer_type\": \"regular\",\n  \"credit_limit\": 500000\n      }"
      },
      "scripts": {
        "post": "if (res.status === 201) {\n  bru.setVar('customerId', res.body.data.id);\n}"
      }
    },
    {
      "name": "List Customers",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/customers?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Create Sale",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/sales",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"company_id\": \"{{companyId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"sale_date\": \"2024-01-15T10:30:00Z\",\n  \"payment_method\": \"cash\",\n  \"notes\": \"Venta mostrador\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 5,\n      \"unit_price\": 3500,\n      \"tax_rate\": 19,\n      \"discount_rate\": 0\n    }\n  ]\n      }"
      },
      "scripts": {
        "post": "if (res.status === 201) {\n  bru.setVar('saleId', res.body.data.id);\n}"
      }
    },
    {
      "name": "List Sales",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/sales?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get Sale by ID",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/sales/{{saleId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Complete Sale",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/sales/{{saleId}}/complete",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Cancel Sale",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/sales/{{saleId}}/cancel",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"reason\": \"Cliente canceló la compra\"\n      }"
      }
    },
    {
      "name": "Create Payment",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/payments",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"sale_id\": \"{{saleId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"payment_number\": \"PAY-001\",\n  \"amount\": 20825,\n  \"method\": \"cash\",\n  \"reference\": \"EFECTIVO\",\n  \"notes\": \"Pago en efectivo\"\n      }"
      }
    },
    {
      "name": "Create Return",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/returns",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"sale_id\": \"{{saleId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"return_number\": \"RET-001\",\n  \"return_date\": \"2024-01-16T10:00:00Z\",\n  \"reason\": \"producto_defectuoso\",\n  \"notes\": \"Botella con fuga\",\n  \"items\": [\n    {\n      \"sale_item_id\": \"\",\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 1,\n      \"unit_price\": 3500,\n      \"tax_rate\": 19,\n      \"condition\": \"defectuoso\"\n    }\n  ]\n      }"
      }
    }
  ]
}
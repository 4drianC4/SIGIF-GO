meta {
  name: Update Customer
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "legal_name": "Comercial Bruno actualizado",
    "document_type": "tax_id",
    "document_number": "BRUNO-TEST-001",
    "phone": "+59170000000",
    "email": "bruno@example.com",
    "address": "Av. Ejemplo 123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

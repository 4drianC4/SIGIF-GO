meta {
  name: 01 Update Single Field
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "phone": "+59171111111"
  }
}

tests {
  test("responde 200, cambia el teléfono y conserva el resto", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar('clientId'));
    expect(res.body.data.phone).to.equal('+59171111111');
    expect(res.body.data.legal_name).to.equal(bru.getVar('originalLegalName'));
    expect(res.body.data.document_number).to.equal(bru.getVar('originalDocument'));
    expect(res.body.data.email).to.equal(bru.getVar('originalEmail'));
    expect(res.body.data.status).to.equal('active');
  });
}

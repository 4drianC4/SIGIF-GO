meta {
  name: 06 Empty Legal Name (400)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "legal_name": "   "
  }
}

tests {
  test("responde 400 VALIDATION_ERROR por nombre vacío", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('legal_name');
  });
}

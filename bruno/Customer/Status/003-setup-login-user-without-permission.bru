meta {
  name: Setup - Login User Without Customer Permissions
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{businessAdminEmail}}",
    "password": "{{businessAdminPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('tokenWithoutPermission', res.body.data.token.access_token);
  }
}

tests {
  test("responde 200 con token de business_admin, que no tiene permisos de clientes", function() {
    expect(res.status).to.equal(200);
  });
}

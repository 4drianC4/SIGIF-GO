meta {
  name: 11 Invalid Id (400)
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/customers/no-es-un-uuid/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("responde 400 BAD_REQUEST con id inválido", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('BAD_REQUEST');
    expect(res.body.error.message).to.equal('invalid customer id');
  });
}

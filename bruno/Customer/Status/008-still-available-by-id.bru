meta {
  name: 05 Still Available By Id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("el cliente se conserva y se consulta por id", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
  });
}

meta {
  name: 06 Block Client
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "blocked"
  }
}

tests {
  test("responde 200 con el cliente bloqueado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('blocked');
  });
}

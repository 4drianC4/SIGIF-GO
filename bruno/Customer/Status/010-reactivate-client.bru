meta {
  name: 07 Reactivate Client
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("responde 200 con el cliente activo", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('active');
  });
}

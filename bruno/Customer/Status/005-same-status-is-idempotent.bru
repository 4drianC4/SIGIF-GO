meta {
  name: 02 Same Status Is Idempotent
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("responde 200 sin modificar updated_at", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
    expect(new Date(res.body.data.updated_at).getTime()).to.equal(new Date(bru.getVar('deactivatedAt')).getTime());
  });
}

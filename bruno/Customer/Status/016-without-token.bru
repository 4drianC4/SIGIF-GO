meta {
  name: 13 Without Token (401)
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("responde 401 UNAUTHORIZED sin token", function() {
    expect(res.status).to.equal(401);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
  });
}

meta {
  name: 04 Listed With Inactive Filter
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{clientTag}}&status=inactive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("aparece con status=inactive", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.data[0].id).to.equal(bru.getVar('clientId'));
  });
}

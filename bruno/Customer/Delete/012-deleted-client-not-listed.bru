meta {
  name: 09 Deleted Client Not Listed
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{clientTag}}&status=all
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("no aparece en el listado en ningún estado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(0);
  });
}

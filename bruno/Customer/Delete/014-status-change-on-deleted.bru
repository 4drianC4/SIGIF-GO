meta {
  name: 11 Status Change On Deleted Client (404)
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("un cliente eliminado no se puede reactivar", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.equal('customer not found');
  });
}

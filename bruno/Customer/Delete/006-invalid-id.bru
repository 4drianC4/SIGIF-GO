meta {
  name: 03 Invalid Id (400)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/customers/no-es-un-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 400 BAD_REQUEST con id inválido", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal('BAD_REQUEST');
    expect(res.body.error.message).to.equal('invalid customer id');
  });
}

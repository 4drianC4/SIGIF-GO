meta {
  name: 06 Document Taken Before Delete (409)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/customers/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "legal_name": "{{clientTag}} Cliente Nuevo",
    "document_type": "tax_id",
    "document_number": "{{clientDocument}}"
  }
}

tests {
  test("responde 409 mientras el cliente existe", function() {
    expect(res.status).to.equal(409);
    expect(res.body.error.code).to.equal('CONFLICT');
  });
}

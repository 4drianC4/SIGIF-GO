meta {
  name: 08 Deleted Client Not Found (404)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("el cliente eliminado ya no se consulta por id", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.equal('customer not found');
  });
}

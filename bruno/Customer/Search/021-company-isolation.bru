meta {
  name: 15 Company Isolation
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/customers/?status=all&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("todos los clientes pertenecen a la empresa del token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    res.body.data.forEach(function(c) {
      expect(c.company_id).to.equal(bru.getVar('companyId'));
    });
  });
}

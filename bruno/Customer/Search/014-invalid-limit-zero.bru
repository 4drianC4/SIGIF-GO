meta {
  name: 08 Invalid Params - Limit Zero (400)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/customers/?limit=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 400 VALIDATION_ERROR con limit=0", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('limit');
  });
}

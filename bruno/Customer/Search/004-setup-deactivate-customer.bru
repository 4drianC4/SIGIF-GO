meta {
  name: Setup - Deactivate Customer
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/customers/{{inactiveCustomerId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("responde 200 con el cliente inactivo", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
  });
}

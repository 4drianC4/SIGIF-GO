meta {
  name: 11 Invalid Params - Unknown Status (400)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/customers/?status=xyz
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 400 VALIDATION_ERROR con status=xyz", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('status');
  });
}

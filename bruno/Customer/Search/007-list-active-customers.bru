meta {
  name: 01 List Active Customers
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/customers/?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 paginado y solo con clientes activos", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta.page).to.equal(1);
    expect(res.body.meta.limit).to.equal(20);
    expect(res.body.meta.total).to.be.at.least(1);
    res.body.data.forEach(function(c) {
      expect(c.status).to.equal('active');
      expect(c).to.have.property('id');
      expect(c).to.have.property('legal_name');
      expect(c).to.not.have.property('credit_limit');
    });
  });
}

meta {
  name: 12 Invalid Params - Sort By Not Allowed (400)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/customers/?sort_by=credit_limit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 400 VALIDATION_ERROR con sort_by fuera de la lista blanca", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('sort_by');
  });
}

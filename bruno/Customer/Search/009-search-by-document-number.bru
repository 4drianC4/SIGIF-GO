meta {
  name: 03 Search By Document Number
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{searchDocument}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("encuentra exactamente el cliente con ese documento", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.data[0].id).to.equal(bru.getVar('activeCustomerId'));
    expect(res.body.data[0].document_number).to.equal(bru.getVar('searchDocument'));
  });
}

meta {
  name: 10 Invalid Params - Negative Page (400)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/customers/?page=-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 400 VALIDATION_ERROR con page=-1", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details).to.have.property('page');
  });
}

meta {
  name: 05 Filter Inactive Status
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{searchTag}}&status=inactive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve solo el cliente inactivo", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.data[0].id).to.equal(bru.getVar('inactiveCustomerId'));
    expect(res.body.data[0].status).to.equal('inactive');
  });
}

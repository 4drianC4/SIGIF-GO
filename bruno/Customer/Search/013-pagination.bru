meta {
  name: 07 Pagination
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{searchTag}}&status=all&page=2&limit=1&sort_by=legal_name&sort_order=asc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("page y limit cuadran con total y total_pages", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta).to.deep.equal({ page: 2, limit: 1, total: 2, total_pages: 2 });
    expect(res.body.data).to.have.lengthOf(1);
    expect(res.body.data[0].id).to.equal(bru.getVar('inactiveCustomerId'));
  });
}

meta {
  name: 02 Search By Partial Name Ignoring Case
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/customers/?q={{nameQuery}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  bru.setVar('nameQuery', encodeURIComponent(bru.getVar('searchTag').toLowerCase() + ' FERRETERIA'));
}

tests {
  test("encuentra solo el cliente activo que coincide", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta.total).to.equal(1);
    expect(res.body.data[0].id).to.equal(bru.getVar('activeCustomerId'));
  });
}

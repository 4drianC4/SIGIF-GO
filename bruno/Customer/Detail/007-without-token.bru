meta {
  name: 04 Without Token (401)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: none
  auth: none
}

tests {
  test("responde 401 UNAUTHORIZED sin token", function() {
    expect(res.status).to.equal(401);
    expect(res.body.error.code).to.equal('UNAUTHORIZED');
  });
}

meta {
  name: 06 Detail Shows Current Status
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 con el estado actual inactive", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('inactive');
    expect(res.body.data.legal_name).to.equal(bru.getVar('clientLegalName'));
  });
}

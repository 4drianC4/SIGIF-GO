meta {
  name: 05 Without Permission (403)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/customers/{{clientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenWithoutPermission}}
}

tests {
  test("responde 403 FORBIDDEN sin customers.read", function() {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal('FORBIDDEN');
  });
}

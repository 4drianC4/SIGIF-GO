meta {
  name: Create Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/customers/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "legal_name": "Comercial Bruno 123",
    "document_type": "tax_id",
    "credit_limit": "2000.00",
    "document_number": "BRUNO-TEST-004",
    "phone": "+59170000001",
    "email": "bruno@ejemplo.com"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

{
  "name": "Companies",
  "requests": [
    {
      "name": "Create Company",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/companies",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"name\": \"Sucursal Centro\",\n  \"legal_name\": \"Sucursal Centro S.A.S.\",\n  \"tax_id\": \"900123456-1\",\n  \"email\": \"centro@sigif.com\",\n  \"phone\": \"+57 1 234 5678\",\n  \"address\": \"Calle 100 # 15-20\",\n  \"city\": \"Bogotá\",\n  \"state\": \"Cundinamarca\",\n  \"country\": \"Colombia\",\n  \"postal_code\": \"110111\"\n}"
      },
      "scripts": {
        "post": "if (res.status === 201) {\n  bru.setVar('companyId', res.body.data.id);\n}"
      }
    },
    {
      "name": "List Companies",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/companies?page=1&limit=20",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Get Company by ID",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/companies/{{companyId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Update Company",
      "method": "PUT",
      "url": "{{baseUrl}}/api/v1/companies/{{companyId}}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ],
      "body": {
        "type": "json",
        "content": "{\n  \"name\": \"Sucursal Centro Principal\",\n  \"legal_name\": \"Sucursal Centro Principal S.A.S.\",\n  \"tax_id\": \"900123456-1\",\n  \"email\": \"centro@sigif.com\",\n  \"phone\": \"+57 1 234 5678\",\n  \"address\": \"Calle 100 # 15-20\",\n  \"city\": \"Bogotá\",\n  \"state\": \"Cundinamarca\",\n  \"country\": \"Colombia\",\n  \"postal_code\": \"110111\",\n  \"settings\": {\n    \"default_currency\": \"COP\",\n    \"tax_rate\": 19,\n    \"invoice_prefix\": \"INV\",\n    \"enable_pos\": true,\n    \"enable_ecommerce\": false\n  }\n}"
      }
    },
    {
      "name": "Activate Company",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/activate",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Deactivate Company",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/deactivate",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    },
    {
      "name": "Delete Company",
      "method": "DELETE",
      "url": "{{baseUrl}}/api/v1/companies/{{companyId}}",
      "headers": [
        { "name": "X-Tenant-ID", "value": "{{tenantId}}" },
        { "name": "Authorization", "value": "Bearer {{accessToken}}" }
      ]
    }
  ]
}
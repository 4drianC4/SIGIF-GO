meta {
  name: Create Supplier
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/suppliers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {

meta {
  name: Cleanup - Release Cashier A
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/cash-register-assignments/{{assignmentAId}}/release
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessTokenA}}
}

tests {
  test("responde 200 y deja la caja libre", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('released');
  });
}

meta {
  name: 10 Cash Register Not Found (404)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/cash-register-assignments/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessTokenB}}
}

body:json {
  {
    "cash_register_id": "{{missingId}}"
  }
}

script:pre-request {
  const hex = '0123456789abcdef';
  let id = '';
  for (let i = 0; i < 32; i++) id += hex[Math.floor(Math.random() * 16)];
  bru.setVar('missingId', id.slice(0, 8) + '-' + id.slice(8, 12) + '-4' + id.slice(13, 16) + '-8' + id.slice(17, 20) + '-' + id.slice(20));
}

tests {
  test("responde 404 NOT_FOUND", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.equal('cash register not found');
  });
}

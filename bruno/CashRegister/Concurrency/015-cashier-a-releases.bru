meta {
  name: 07 Cashier A Releases Cash Register
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/cash-register-assignments/{{assignmentAId}}/release
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessTokenA}}
}

script:post-response {
  bru.setVar('releasedAtA', res.body && res.body.data ? res.body.data.released_at : '');
}

tests {
  test("responde 200 con la asignación liberada por el cajero A", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal('released');
    expect(res.body.data.released_at).to.be.a('string');
    expect(res.body.data.released_by).to.equal(bru.getVar('cashierAId'));
  });
}

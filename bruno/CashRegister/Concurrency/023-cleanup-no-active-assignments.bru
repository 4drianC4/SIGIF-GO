meta {
  name: Cleanup - Verify Cashier B Has No Assignment
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/cash-register-assignments/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessTokenB}}
}

tests {
  test("todas las asignaciones de prueba quedaron liberadas", function() {
    expect(res.status).to.equal(404);
    expect(res.body.error.code).to.equal('NO_ACTIVE_ASSIGNMENT');
  });
}

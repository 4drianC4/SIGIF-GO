meta {
  name: Setup - Login Business Admin
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{businessAdminEmail}}",
    "password": "{{businessAdminPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar('accessTokenSupervisor', res.body.data.token.access_token);
    bru.setVar('businessAdminId', res.body.data.user.id);
  }
}

tests {
  test("responde 200 con token de un usuario con empresa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.company_id).to.be.a('string');
  });
}

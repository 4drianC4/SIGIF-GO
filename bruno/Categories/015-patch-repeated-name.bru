meta {
  name: Patch Repeated Name At The Same Level (409)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/categories/{{parentId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{otherName}}"
  }
}

tests {
  test("responde 409 CONFLICT", function() {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('CONFLICT');
    expect(res.body.error.message).to.equal('category name already exists');
  });
}

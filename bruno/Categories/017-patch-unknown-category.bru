meta {
  name: Patch Unknown Category (404)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/categories/00000000-0000-4000-8000-000000000000
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Fantasma"
  }
}

tests {
  test("responde 404 NOT_FOUND", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.equal('category not found');
  });
}

meta {
  name: Setup - Create Product In Subcategory
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Producto {{childName}}",
    "category_id": "{{childId}}",
    "unit_of_measure_id": "{{unitId}}",
    "cost": 1,
    "sale_price": 2
  }
}

script:post-response {
  bru.setVar('productId', res.body && res.body.data ? res.body.data.id : '');
}

tests {
  test("responde 201", function() {
    expect(res.status).to.equal(201);
  });
}

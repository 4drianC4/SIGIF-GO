meta {
  name: Delete Category With Products (409)
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/api/v1/categories/{{childId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 409 CONFLICT", function() {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('CONFLICT');
    expect(res.body.error.message).to.equal('category has products');
  });
}

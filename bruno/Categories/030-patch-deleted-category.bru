meta {
  name: Patch Deleted Category (404)
  type: http
  seq: 30
}

patch {
  url: {{baseUrl}}/api/v1/categories/{{childId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Revivida"
  }
}

tests {
  test("responde 404 NOT_FOUND", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NOT_FOUND');
  });
}

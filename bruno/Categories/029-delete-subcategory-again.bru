meta {
  name: Delete Subcategory Again (404)
  type: http
  seq: 29
}

delete {
  url: {{baseUrl}}/api/v1/categories/{{childId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 404 NOT_FOUND", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('NOT_FOUND');
    expect(res.body.error.message).to.equal('category not found');
  });
}

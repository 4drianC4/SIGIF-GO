meta {
  name: Patch Read Only And Unknown Fields (400)
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/categories/{{childId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "parent_id": "{{otherId}}",
    "color": "rojo"
  }
}

tests {
  test("responde 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('VALIDATION_ERROR');
    expect(res.body.error.details.parent_id).to.be.a('string');
  });
}

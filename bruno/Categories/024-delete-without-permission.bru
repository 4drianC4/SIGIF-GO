meta {
  name: Delete Without Permission (403)
  type: http
  seq: 24
}

delete {
  url: {{baseUrl}}/api/v1/categories/{{childId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

script:pre-request {
  // Bruno reenvía la cookie HttpOnly del último login; se borra para que
  // la petición viaje sin credenciales o solo con el Bearer indicado.
  await bru.cookies.delete('sigif_access_token');
}

tests {
  test("responde 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('FORBIDDEN');
  });
}

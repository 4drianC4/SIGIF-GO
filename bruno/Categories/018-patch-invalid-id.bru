meta {
  name: Patch Invalid Id (400)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/v1/categories/abc
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Otra"
  }
}

tests {
  test("responde 400 BAD_REQUEST", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal('BAD_REQUEST');
  });
}
